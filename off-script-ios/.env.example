# Public owner-selected release metadata. Copy to .env.local, then fill the values.
# Do not put Apple private keys, passwords, signing certificates or auth tokens here.
OFFSCRIPT_IOS_BUNDLE_ID=
OFFSCRIPT_EAS_PROJECT_ID=
OFFSCRIPT_PRIVACY_URL=
OFFSCRIPT_SUPPORT_URL=
# Optional; otherwise select your authorized team in Xcode/EAS.
OFFSCRIPT_APPLE_TEAM_ID=
# Optional website build settings. These are public, not credentials.
# Use your chosen origin only, with HTTPS and no path (for example your Vercel domain).
OFFSCRIPT_SITE_URL=
# This email is published on the support/privacy pages. Use an approved public address.
OFFSCRIPT_SUPPORT_EMAIL=
