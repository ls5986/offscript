{
  "name": "off-script",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:review": "tsx scripts/review-v1-prompts.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/unit/repository.test.ts tests/unit/native-repository.test.ts",
    "test:e2e:web": "playwright test",
    "doctor": "expo-doctor",
    "postbuild:web": "node scripts/offline.mjs",
    "lint": "eslint app src scripts tests",
    "format": "prettier --write app src scripts tests *.json *.ts *.css",
    "prebuild:web": "npm run content:validate",
    "eas-build-post-install": "npm run content:validate && npm run typecheck",
    "ios:check": "tsx scripts/check-ios-release.ts",
    "ios:check:local": "tsx scripts/check-ios-release.ts --release --local",
    "ios:export": "expo export --platform ios --output-dir native-export",
    "ios:simulator": "expo start --ios",
    "ios:build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:build:production": "npm run ios:check -- --release && npx eas-cli@latest build --platform ios --profile production",
    "ios:submit": "npm run ios:check -- --submit && npx eas-cli@latest submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.21.4",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^24.3.0"
  }
}
